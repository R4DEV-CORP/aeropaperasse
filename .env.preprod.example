# =====================================================================
# Preprod (dev.aeropaperasse.fr) — multi-tenant baseline.
# Copy into Forge's "Environment" editor and fill the secrets (APP_KEY,
# DB_PASSWORD, RESEND_API_KEY). Do NOT commit the real values.
# =====================================================================

APP_NAME=Aeropaperasse
APP_ENV=production
# Generate on the server: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://dev.aeropaperasse.fr

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (multi-tenant) ---------------------------------------
# Default connection is the CENTRAL database (tenant registry, users,
# trainings, sessions). Tenant databases (tenant_<id>) are created
# dynamically by stancl/tenancy — the DB user below MUST have the
# CREATE DATABASE privilege.
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aeropaperasse_central
DB_USERNAME=forge
DB_PASSWORD=

# --- Session -------------------------------------------------------
# Sessions must live OUTSIDE the tenant switch → stored in the central DB.
# Cookie shared across dev.* and *.dev.* so login carries between tenants.
# secure=true because preprod is served over HTTPS.
SESSION_DRIVER=database
SESSION_CONNECTION=central
SESSION_LIFETIME=120
SESSION_DOMAIN=.dev.aeropaperasse.fr
SESSION_SECURE_COOKIE=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ----------------------------------------------------------
# Start on `log` so the first login (2FA mail) isn't blocked while Resend
# is being wired. Switch to `resend` + set RESEND_API_KEY when ready.
MAIL_MAILER=log
# MAIL_MAILER=resend
# RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@aeropaperasse.fr"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
